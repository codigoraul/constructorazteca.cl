---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
interface Props { title?: string; description?: string; image?: string; solidHeader?: boolean; type?: string }
const isTest = import.meta.env.BASE_URL.replace(/\/$/, '') !== '';
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';
const { title, description = SITE.description, image = '/logo.png', solidHeader = path !== '/', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} en Ancud, Chiloé | Construcción e inmobiliaria`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'GeneralContractor', name: SITE.name, url: SITE.url,
  image: new URL('/logo.png', SITE.url).href, telephone: SITE.phoneRaw, email: SITE.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Ancud', addressRegion: 'Los Lagos', addressCountry: 'CL' },
  areaServed: 'Chiloé', sameAs: [SITE.facebook, SITE.instagram],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {isTest && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2D2D2D" />
    <meta property="og:type" content={type} /><meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={SITE.name} /><meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} /><meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@500;600;700;800&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Saltar al contenido</a>
    <Header solid={solidHeader} />
    <main id="main"><slot /></main>
    <Footer />
    <a class="wa" href={`https://wa.me/${SITE.phoneRaw.replace('+', '')}?text=${encodeURIComponent('Hola, quiero cotizar un proyecto con Constructora Azteca.')}`} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><Icon name="whatsapp" size={28} /></a>
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
    <style is:global>
      .wa{position:fixed;right:22px;bottom:22px;z-index:40;width:58px;height:58px;border-radius:50%;background:var(--orange);color:var(--charcoal);display:grid;place-items:center;box-shadow:0 12px 30px -8px rgba(0,0,0,.45);transition:transform .3s var(--ease),background .3s}
      .wa:hover{transform:scale(1.08);background:var(--orange-dark);color:#fff}
    </style>
  </body>
</html>
