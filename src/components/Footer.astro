---
import { SITE } from '../lib/site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__grid">
    <div>
      <img src="/logo-light.svg" alt="Constructora Azteca" width="200" height="55" class="footer__logo" loading="lazy" />
      <p>Desarrollamos proyectos de vivienda social y privada en sector urbano y rural, construyendo y respaldando el sueño de muchas familias.</p>
    </div>
    <div>
      <h3>Navegación</h3>
      <ul>
        <li><a href="/nosotros">Nosotros</a></li><li><a href="/proyectos">Proyectos</a></li>
        <li><a href="/servicios">Servicios</a></li><li><a href="/parcelas">Parcelas</a></li><li><a href="/contacto">Contáctanos</a></li>
      </ul>
    </div>
    <div>
      <h3>Contacto</h3>
      <ul class="contact">
        <li><Icon name="phone" size={18} /><a href={`tel:${SITE.phoneRaw}`}>{SITE.phone}</a></li>
        <li><Icon name="mail" size={18} /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><Icon name="pin" size={18} /><span>{SITE.address}</span></li>
      </ul>
      <div class="soc">
        <a href={SITE.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={20} /></a>
        <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={20} /></a>
        <a href={`https://wa.me/${SITE.phoneRaw.replace('+','')}`} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" size={20} /></a>
      </div>
    </div>
  </div>
  <div class="container footer__legal">© {year} Constructora Azteca Ltda. Todos los derechos reservados.</div>
</footer>
<style>
  .footer{background:var(--charcoal);color:#bdbdbd;padding-top:clamp(56px,7vw,88px);font-size:.98rem;border-top:4px solid var(--orange)}
  .footer__grid{display:grid;gap:40px;grid-template-columns:1.4fr .8fr 1fr;padding-bottom:56px}
  .footer__logo{height:52.9px;width:auto;margin-bottom:22px}
  .footer h3{color:#fff;font-size:.82rem;letter-spacing:.2em;text-transform:uppercase;margin-bottom:22px}
  .footer ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}
  .footer a:hover{color:var(--orange)}
  .contact li{display:flex;gap:12px;align-items:center}.contact svg{color:var(--orange);flex:none}
  .soc{display:flex;gap:12px;margin-top:22px}
  .soc a{width:42px;height:42px;border:1px solid #555;display:grid;place-items:center;transition:background .3s,border-color .3s,color .3s}
  .soc a:hover{background:var(--orange);border-color:var(--orange);color:var(--charcoal)}
  .footer__legal{border-top:1px solid #444;padding-block:22px;font-size:.85rem;color:#8d8d8d}
  @media (max-width:820px){.footer__grid{grid-template-columns:1fr}}
</style>
