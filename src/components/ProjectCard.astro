---
import type { Project } from '../lib/types';
import Icon from './Icon.astro';
const { p, eager = false } = Astro.props as { p: Project; eager?: boolean };
const im = p.card ?? p.hero;
const meta = [p.location, p.surface].filter(Boolean).join(' · ');
---
<a class="pcard reveal" href={`/proyectos/${p.slug}`} aria-label={`Proyecto ${p.title}`}>
  {im && <img src={im.small ?? im.src} srcset={im.small ? `${im.small} 640w, ${im.src} 1920w` : undefined} sizes="(min-width:1000px) 380px, (min-width:600px) 50vw, 100vw" alt={`Proyecto ${p.title}`} width={im.width} height={im.height} loading={eager ? 'eager' : 'lazy'} decoding="async" />}
  <div class="pcard__over">
    {meta && <span class="pcard__meta">{meta}</span>}
    <h3>Proyecto {p.title}</h3>
    <span class="pcard__more">Ver proyecto <Icon name="arrow" size={16} /></span>
  </div>
</a>
<style>
  .pcard{position:relative;display:block;overflow:hidden;background:var(--gray-100);break-inside:avoid;margin:0 0 clamp(14px,1.4vw,22px)}
  .pcard img{width:100%;height:auto;display:block;transition:transform 1.1s var(--ease)}
  .pcard:hover img{transform:scale(1.06)}
  .pcard::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(45,45,45,.88) 0%,rgba(45,45,45,.35) 38%,transparent 65%);transition:background .5s var(--ease)}
  .pcard:hover::after{background:linear-gradient(0deg,rgba(45,45,45,.94) 0%,rgba(45,45,45,.55) 55%,rgba(45,45,45,.15) 100%)}
  .pcard__over{position:absolute;left:0;right:0;bottom:0;z-index:1;padding:clamp(16px,1.6vw,24px);color:#fff}
  .pcard__meta{display:block;font-family:var(--font-head);font-size:.62rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-light);margin-bottom:6px}
  .pcard h3{color:#fff;font-size:clamp(.8rem,.95vw,.92rem);font-weight:600;text-transform:uppercase;letter-spacing:.07em;line-height:1.3;margin:0}
  .pcard__more{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-head);font-weight:700;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--orange);max-height:0;opacity:0;overflow:hidden;transition:max-height .45s var(--ease),opacity .4s,margin .4s}
  .pcard:hover .pcard__more,.pcard:focus-visible .pcard__more{max-height:30px;opacity:1;margin-top:12px}
  .pcard::before{content:"";position:absolute;left:0;bottom:0;height:4px;width:0;background:var(--orange);z-index:2;transition:width .5s var(--ease)}
  .pcard:hover::before{width:100%}
  @media (hover:none){.pcard__more{max-height:30px;opacity:1;margin-top:12px}}
</style>
