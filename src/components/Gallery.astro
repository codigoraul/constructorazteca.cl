---
import type { Img } from '../lib/types';
const { images, title = '' } = Astro.props as { images: Img[]; title?: string };
---
{images.length > 0 && (
  <div class="gal" data-gallery>
    {images.map((im, i) => (
      <button class="gal__item" data-i={i} aria-label={`Ampliar imagen ${i + 1} de ${images.length}`}>
        <img src={im.small ?? im.src} alt={im.alt || `${title} – imagen ${i + 1}`} width={im.width} height={im.height} loading="lazy" decoding="async" />
      </button>
    ))}
  </div>
  <dialog class="lb" id="lightbox" aria-label="Galería de imágenes">
    <button class="lb__x" data-close aria-label="Cerrar">✕</button>
    <button class="lb__nav lb__prev" data-prev aria-label="Anterior">‹</button>
    <img class="lb__img" alt="" />
    <button class="lb__nav lb__next" data-next aria-label="Siguiente">›</button>
    <span class="lb__count"></span>
  </dialog>
  <script type="application/json" id="gallery-data" set:html={JSON.stringify(images.map((i) => ({ src: i.src, alt: i.alt ?? title })))} />
)}
<style>
  .gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:14px}
  .gal__item{padding:0;border:0;background:var(--gray-100);aspect-ratio:4/3;overflow:hidden;cursor:zoom-in;position:relative}
  .gal__item img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease),filter .4s}
  .gal__item:hover img{transform:scale(1.08)}
  .gal__item::after{content:"+";position:absolute;inset:0;display:grid;place-items:center;font-size:2.4rem;color:#fff;background:rgba(45,45,45,.45);opacity:0;transition:opacity .3s}
  .gal__item:hover::after{opacity:1}
  .lb{border:0;padding:0;background:transparent;max-width:100vw;max-height:100vh;width:100vw;height:100vh;color:#fff}
  .lb::backdrop{background:rgba(20,20,20,.94)}
  .lb[open]{display:grid;place-items:center}
  .lb__img{max-width:92vw;max-height:86vh;object-fit:contain}
  .lb__x,.lb__nav{position:absolute;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.3);color:#fff;cursor:pointer;width:52px;height:52px;font-size:1.6rem;line-height:1;transition:background .3s,color .3s}
  .lb__x:hover,.lb__nav:hover{background:var(--orange);color:var(--charcoal);border-color:var(--orange)}
  .lb__x{top:20px;right:20px;font-size:1.2rem}.lb__prev{left:20px}.lb__next{right:20px}
  .lb__count{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);font-family:var(--font-head);letter-spacing:.15em;font-size:.85rem}
</style>
<script>
  const root = document.querySelector('[data-gallery]');
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (root && dlg) {
    const data: { src: string; alt: string }[] = JSON.parse(document.getElementById('gallery-data')!.textContent || '[]');
    const img = dlg.querySelector('.lb__img') as HTMLImageElement; const cnt = dlg.querySelector('.lb__count')!;
    let i = 0;
    const show = (n: number) => { i = (n + data.length) % data.length; img.src = data[i].src; img.alt = data[i].alt; cnt.textContent = `${i + 1} / ${data.length}`; };
    root.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-i]'); if (b) { show(Number(b.dataset.i)); dlg.showModal(); } });
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
  }
</script>
