---
import { SITE } from '../lib/site';
import Icon from './Icon.astro';
const { title = '¿Tienes un terreno o un proyecto en mente?', text = 'Cuéntanos tu idea y te ayudamos a hacerla realidad: diseño, permisos, subsidios y construcción.' } = Astro.props;
---
<section class="cta">
  <div class="container cta__in">
    <div><h2>{title}</h2><p>{text}</p></div>
    <div class="cta__btns">
      <a class="btn" href="/contacto">Solicitar cotización <Icon name="arrow" size={18} /></a>
      <a class="btn btn--ghost" href={`https://wa.me/${SITE.phoneRaw.replace('+','')}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
    </div>
  </div>
</section>
<style>
  .cta{background:#fff;color:var(--charcoal);padding-block:clamp(56px,7vw,96px);border-top:1px solid #e6e6e6}
  .cta__in{display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap}
  .cta h2{margin-bottom:.3em;max-width:26ch;color:var(--charcoal)}.cta p{margin:0;max-width:52ch;color:var(--gray-600)}
  .cta :global(.btn--ghost){color:var(--charcoal);border-color:var(--charcoal);background:transparent}
  .cta :global(.btn--ghost:hover){background:var(--charcoal);color:#fff}
  .cta__btns{display:flex;gap:14px;flex-wrap:wrap}
</style>
