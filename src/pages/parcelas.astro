---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { getContent, money } from '../lib/wp';
const c = await getContent();
const list = c.services.filter((s) => s.kind === 'parcela');
---
<Base title="Parcelas en venta" description="Venta de parcelas en el archipiélago de Chiloé, con bosque nativo, praderas y vertientes naturales. Parcelas Mechaico y Piruquina, Ancud.">
  <PageHero title="Inmobiliaria" lead="Tenemos a la venta parcelas en el archipiélago de Chiloé, cada una con el encanto del sur: hermosos bosques nativos, praderas y vertientes naturales." image={{ src: '/hero/hero-parcelas.webp', srcset: '/hero/hero-parcelas-960.webp 960w, /hero/hero-parcelas.webp 1920w', width: 1920, height: 700, position: 'center 22%' }} crumbs={[{ label: 'Parcelas' }]} />
  <section class="section section--gray">
    <div class="container">
      
      <div class="section-head section-head--center"><span class="eyebrow">Parcelas</span><h2>Venta de Parcelas</h2></div>
      <div class="grid grid--2">
        {list.map((s) => (
          <a class="pc reveal" href={`/servicios/${s.slug}`}>
            <div class="pc__m">{s.hero && <img src={s.hero.small ?? s.hero.src} alt={s.title} width={s.hero.width} height={s.hero.height} loading="lazy" />}</div>
            <div class="pc__b">
              <h3>{s.title}</h3><p>{s.excerpt}</p>
              {s.price && <p class="pc__p"><small>Desde</small> <b>{money(s.price)}</b></p>}
              <span class="link-arrow">Leer detalles <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand title="¿Quieres visitar una parcela?" text="Coordinemos una visita y resolvemos tus dudas sobre factibilidad de agua, luz y acceso." />
</Base>
<style>
  .pc{display:grid;grid-template-columns:1fr;background:#fff;border:1px solid #e6e6e6;transition:transform .45s var(--ease),box-shadow .45s var(--ease)}
  .pc:hover{transform:translateY(-8px);box-shadow:var(--shadow)}
  .pc__m{aspect-ratio:16/10;overflow:hidden}.pc__m img{width:100%;height:100%;object-fit:cover;transition:transform 1s var(--ease)}.pc:hover .pc__m img{transform:scale(1.06)}
  .pc__b{padding:28px 30px 32px}.pc__b p{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .pc__p{color:var(--charcoal)}.pc__p b{font-family:var(--font-head);font-weight:600;font-size:1.25rem}.pc__p small{text-transform:uppercase;letter-spacing:.14em;font-size:.72rem}
</style>
